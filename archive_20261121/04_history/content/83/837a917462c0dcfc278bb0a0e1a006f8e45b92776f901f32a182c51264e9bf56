#!/usr/bin/env python3
"""Refresh release hashes after completing and verifying a new working edition."""
from pathlib import Path
from datetime import datetime, timezone
import argparse
import hashlib
import json


def sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("directory", nargs="?", default=str(Path(__file__).resolve().parent))
    parser.add_argument("--edition", type=int, default=17)
    args = parser.parse_args()
    root = Path(args.directory).resolve()
    rows = []
    for path in sorted(root.rglob("*")):
        if path.is_symlink():
            raise SystemExit(f"Refusing a symlink in the released package: {path}")
        if not path.is_file():
            continue
        name = path.relative_to(root).as_posix()
        if name in {"MANIFEST.json", "SHA256SUMS.txt"}:
            continue
        rows.append({"path": name, "bytes": path.stat().st_size, "sha256": sha256(path)})
    manifest = {
        "schema_version": 1,
        "edition": args.edition,
        "created_at_utc": datetime.now(timezone.utc).isoformat(),
        "scope": "Complete inventory of this released handover tree, not a claim that all books are translated.",
        "files": rows,
        "excluded_from_inventory": ["MANIFEST.json", "SHA256SUMS.txt"],
    }
    path = root / "MANIFEST.json"
    path.write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    sums = [(row["path"], row["sha256"]) for row in rows]
    sums.append(("MANIFEST.json", sha256(path)))
    (root / "SHA256SUMS.txt").write_text("".join(f"{digest}  {name}\n" for name, digest in sorted(sums)), encoding="utf-8")
    print(json.dumps({"files": len(rows), "bytes": sum(row["bytes"] for row in rows), "manifest_sha256": sha256(path)}, ensure_ascii=False))
