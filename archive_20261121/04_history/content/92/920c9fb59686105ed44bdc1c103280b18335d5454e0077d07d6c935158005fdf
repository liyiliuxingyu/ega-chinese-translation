#!/usr/bin/env python3
from __future__ import annotations
import hashlib
import json
import sys
from pathlib import Path

root = Path(sys.argv[1] if len(sys.argv) > 1 else Path(__file__).resolve().parents[1]).resolve()
manifest_path = root / "MANIFEST.json"
if not manifest_path.is_file():
    raise SystemExit(f"缺少清单: {manifest_path}")
data = json.loads(manifest_path.read_text(encoding="utf-8"))
errors: list[str] = []
for item in data["files"]:
    p = root / item["path"]
    if not p.is_file():
        errors.append(f"缺少文件: {item['path']}")
        continue
    size = p.stat().st_size
    if size != item["size"]:
        errors.append(f"大小不符: {item['path']} expected={item['size']} actual={size}")
        continue
    h = hashlib.sha256()
    with p.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    actual = h.hexdigest()
    if actual != item["sha256"]:
        errors.append(f"哈希不符: {item['path']}")
if errors:
    print("校验失败：")
    print("\n".join(errors))
    raise SystemExit(1)
print(f"校验通过：{len(data['files'])} 个文件，版本 {data['package_version']}。")
