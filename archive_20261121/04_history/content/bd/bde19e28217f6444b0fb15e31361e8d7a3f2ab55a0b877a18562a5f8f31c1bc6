from pathlib import Path,PurePosixPath
import hashlib,sys,zipfile,shutil
BASE_SHA='a94b6f7476fb0846e84309d1cde0b1194ef2910ff281b20105b823cf0f71870d'
def sha(p):
 with p.open('rb') as f: return hashlib.file_digest(f,'sha256').hexdigest()
def safe(n):
 p=PurePosixPath(n)
 if p.is_absolute() or '..' in p.parts or '\\' in n: raise RuntimeError(n)
 return p
def validate(root):
 found=set()
 for l in (root/'SHA256SUMS.txt').read_text(encoding='utf-8').splitlines():
  h,n=l.split('  ',1); safe(n); f=root/n
  if n in found or not f.is_file() or sha(f)!=h: raise RuntimeError(f'文件校验不一致：{n}')
  found.add(n)
 files={p.relative_to(root).as_posix() for p in root.rglob('*') if p.is_file()}-{'SHA256SUMS.txt'}
 if found!=files: raise RuntimeError('文件清单与实际文件不等')
 return len(found)
if len(sys.argv)!=3: raise SystemExit('用法：python apply.py 第二辑完整工程.zip 新目录')
base=Path(sys.argv[1]).resolve(); dst=Path(sys.argv[2]).resolve(); mine=Path(__file__).resolve().parent
if dst.exists(): raise SystemExit('请指定不存在的新目录，不覆盖任何已有文件')
if sha(base)!=BASE_SHA: raise SystemExit('第二辑完整工程的 SHA-256 不匹配')
with zipfile.ZipFile(base) as z:
 for n in z.namelist():
  path=safe(n)
  if path.parts[0]!='EGA_v17_V_supplement_II':raise RuntimeError(n)
  if n.endswith('/'):continue
  target=dst/Path(*path.parts[1:]); target.parent.mkdir(exist_ok=True,parents=True)
  with z.open(n) as src,target.open('wb') as out:shutil.copyfileobj(src,out)
for f in (mine/'patch').rglob('*'):
 if not f.is_file():continue
 target=dst/f.relative_to(mine/'patch');target.parent.mkdir(exist_ok=True,parents=True);shutil.copyfile(f,target)
print(f'已恢复并校验 {validate(dst)} 个条目：{dst}')

