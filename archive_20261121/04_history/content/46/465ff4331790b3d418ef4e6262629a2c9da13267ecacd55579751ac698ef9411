def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def get_source(name, latest=False):
    base = ROOT / ('unpacked/dot_latest' if latest else 'unpacked/dot_batches')
    directory = base / f'EGA第五卷_{name}_续译工程'
    matches = list(directory.glob('*.tex'))
    assert len(matches) == 1, (directory, matches)
    return matches[0]

def body(path):
    text = path.read_text()
    start = text.find('\\chapter*{§')
    if '\\chapter*{第二部分' in text:
        start = text.index('\\chapter*{第二部分')
    assert start >= 0, path
    text = text[start:text.index('\\end{document}', start)]
    text = re.sub(r'\\chapter\*\{[^\n]*\}\s*', '', text)
    text = text.replace('\\newpage', '')
    text = text.replace('\\enlargethispage{3\\baselineskip}', '')
    text = text.replace('本批', '本段译校').replace('上一批', '前文').replace('前批', '前文')
    return text.strip()

