# TeX diagrams preserve all four objects and arrows while avoiding text arrows.
pattern = re.compile(r'\\begin\{array\}\{ccc\}\s*([^&\n]+)&\\longleftarrow&([^\n]+)\\\\\s*\\big\\downarrow&&\\big\\downarrow\\\\\s*([^&\n]+)&\\longleftarrow&([^\n]+)\s*\\end\{array\}')
def diagram(m):
    a,b,c,d = [x.strip().removesuffix('.') for x in m.groups()]
    return f'\\begin{{tikzcd}}\n{a} \\arrow[d] & {b} \\arrow[l] \\arrow[d] \\\\\n{c} & {d} \\arrow[l]\n\\end{{tikzcd}}'
text, converted = pattern.subn(diagram, text)
assert converted == 5, converted

