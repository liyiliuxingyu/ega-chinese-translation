manifest=[];bodies=[];reports=[]
for number,key in enumerate(ORDER,1):
    folder=SOURCE/('EGA第五卷_'+key)
    ps=list(folder.glob('EGA*.tex'));assert len(ps)==1,ps
    p=ps[0];t=p.read_text();progress=json.loads((folder/'PROGRESS.json').read_text())
    manifest.append(dict(order=number,file=str(p),sha256=hashlib.sha256(p.read_bytes()).hexdigest(),progress=progress))
    if '\\mainmatter' in t:
        body=t.split('\\mainmatter',1)[1]
    else:
        starts=list(re.finditer(r'\\chapter\*\{[^\n]*\}',t))
        assert len(starts)>=2,p
        body=t[starts[1].start():]
    if '\\backmatter' in body:
        body,rep=body.split('\\backmatter',1)
        rep=rep.split('\\end{document}',1)[0]
    else:rep=''
    body=body.split('\\end{document}',1)[0]
    if key.startswith('第7节'):
        reports.append(rep.split('\\bigskip',1)[0])
    elif key.startswith('8.6后'):
        reports.append('\\subsection*{余法丛论证的补充核验}\n'+rep.split('对概形论证明的独立核查包括：',1)[1].split('\\textbf{限制：}',1)[0])
        notation=t.split('\\textbf{统一记号（译校整理）：}',1)[1].split('\\mainmatter',1)[0]
        pos=body.index('\n',body.index('\\chapter*'))
        body=body[:pos+1]+'\\noindent\\textbf{译校记号约定。}'+notation+'\n'+body[pos+1:]
    elif key.startswith('8.7'):
        reports.append(rep.split('\\section*{可核实部分',1)[0])
    elif key.startswith('8.9'):
        notation=t.split('统一记号：',1)[1].split('\n\n查阅原对话',1)[0]
        pos=body.index('\n',body.index('\\chapter*'))
        body=body[:pos+1]+'\\noindent\\textbf{译校记号约定。}'+notation+'\n'+body[pos+1:]
    if key.startswith('8.12'):
        body=body.split('\\section*{接续位置}',1)[0]
    body=re.sub(r'\\addcontentsline\{toc\}\{chapter\}\{[^\n]*\}\s*','',body)
    body=body.replace('\\newpage','')
    bodies.append(body)

text='\n'.join(f'% DOT_IMPORT {i+1:02d} {ORDER[i]}\n'+s for i,s in enumerate(bodies))
