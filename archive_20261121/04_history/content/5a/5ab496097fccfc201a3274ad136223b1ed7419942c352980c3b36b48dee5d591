# Normalize note macros and small mathematical shorthands without loading another preamble.
def normalize(s):
    s=s.replace(r'\Yss',r'{Y^{\mathrm{sup\,sing}}}').replace(r'\Ys',r'{Y^{\mathrm{sing}}}')
    s=s.replace(r'\cO',r'\mathcal O').replace(r'\supp',r'\operatorname{Supp}')
    s=s.replace('本批译校注：','Dot译校注：').replace('本批','此处译校')
    s=s.replace('上一批','前文译校').replace('下一批','后续译校')
    s=re.sub(r'\\(?:note|corr|tnote)\{',r'\\transnote{',s)
    return s
